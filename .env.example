# Copy to .env and fill in. Both values are inlined into the bundle at build time,
# so the host must have them set *before* the build runs — setting them afterwards
# has no effect until the next build.
#
# VITE_GRAPHQL_TOKEN ships in the client bundle and is readable by anyone who opens
# devtools. It is a scoped challenge credential, not a secret.

VITE_GRAPHQL_ENDPOINT=
VITE_GRAPHQL_TOKEN=
